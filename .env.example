# Server
PORT=8080
ENV=development

# Database
RUN_MIGRATIONS=true
DATABASE_URL=postgres://hzzt:hzzt_dev_password@localhost:5432/hzzt_dev?sslmode=disable
TEST_DATABASE_URL=postgres://hzzt:hzzt_test_password@localhost:5433/hzzt_test?sslmode=disable

# Auth
JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# CORS
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000

# Email
EMAIL_DRIVER=console
RESEND_API_KEY=

# Market data (fill in once you reach P11/P12)
CMC_API_KEY=
# How often AUTO crypto prices are refreshed (minutes, default 15)
CMC_REFRESH_MINUTES=15
MASSIVE_API_KEY=
MASSIVE_MODE=EOD
# Client-side request budget for Massive (free tier: 5 per minute)
MASSIVE_RATE_PER_MIN=5

# FX
FX_PROVIDER=frankfurter # frankfurter | freecurrencyapi

# freecurrencyapi.com key; required when FX_PROVIDER=freecurrencyapi (the default frankfurter needs none)
FREECURRENCY_API_KEY=

# Sender used by the resend driver
EMAIL_FROM=Hzzt <onboarding@resend.dev>
